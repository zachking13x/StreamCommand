<UserControl x:Class="StreamCommand.Views.StreamValueSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource AccentMuted}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="12"
            Padding="20,16" Margin="0,0,0,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Icon + headline row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeadlineText"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Sub-message -->
                <TextBlock x:Name="SubText"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- CTA button -->
                <Button x:Name="CtaButton" Content="Unlock Pro — from $6.99/mo"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,8" HorizontalAlignment="Left"
                        Click="CtaButton_Click"/>
            </StackPanel>

            <!-- Dismiss X -->
            <Button Grid.Column="1" Content="✕"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource MutedText}"
                    FontSize="14" Cursor="Hand" Padding="8,4"
                    Click="Dismiss_Click"/>
        </Grid>
    </Border>

</UserControl>
