<UserControl x:Class="StreamCommand.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamCommand.Views"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1100">

            <!-- Ready to Stream Banner -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Ready to Stream?" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,12,0"/>
                            <!-- OBS connection status pill -->
                            <Border x:Name="OBSPill"
                                    Background="#1A1A2E" BorderBrush="#EF4444"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="8,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="OBSPillDot" Width="6" Height="6"
                                             Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OBSPillText" Text="OBS: Disconnected"
                                               Foreground="#EF4444" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Launch your stream with one click and manage everything from here."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="▶   Go Live"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10"
                            FontSize="14"
                            Click="GoLive_Click"/>
                </Grid>
            </Border>

            <!-- Stats Row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Live Viewers -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="👥  LIVE VIEWERS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LiveViewersText" Text="—"
                                   Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                        <TextBlock Text="Not streaming" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Followers -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="♥  FOLLOWERS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="FollowerCountText" Text="—"
                                   Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="FollowerSubText" Text="Connect Twitch to see count"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chat Messages -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="💬  CHAT MESSAGES" Style="{StaticResource Label}"/>
                        <TextBlock Text="—" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                        <TextBlock Text="Not streaming" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Streams This Month -->
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📺  STREAMS THIS MONTH" Style="{StaticResource Label}"/>
                        <TextBlock Text="2" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                        <TextBlock Text="May 2026" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Preview Card — appears while streaming, gated behind Pro -->
            <Border x:Name="DashPreviewCard"
                    Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="Collapsed">
                <Grid>
                    <!-- Upgrade prompt — free users -->
                    <local:ProGateBanner x:Name="DashPreviewGate"
                                         FeatureLabel="Live stream preview"
                                         Visibility="Collapsed"/>

                    <!-- Preview feed — Pro users -->
                    <StackPanel x:Name="DashPreviewContent" Visibility="Collapsed">
                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                        <Grid Background="#0A0A0F" MaxHeight="140">
                            <Image x:Name="DashPreviewImage"
                                   Stretch="Uniform"
                                   MaxHeight="140"/>
                            <!-- LIVE badge — top-right -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#CC000000" CornerRadius="4"
                                    Padding="8,4" Margin="8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#EF4444"
                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="LIVE" Foreground="White"
                                               FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- Viewer count — top-left -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#CC000000" CornerRadius="4"
                                    Padding="8,4" Margin="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DashPreviewViewerCount"
                                               Text="—" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pre-Stream Checklist Progress -->
            <Border x:Name="ChecklistCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Pre-Stream Checklist" Style="{StaticResource SectionHeader}" Margin="0,0,12,0"/>
                            <Border x:Name="ChecklistBadge"
                                    Background="#2E1065" BorderBrush="{DynamicResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ChecklistBadgeText" Text="0 / 19"
                                           Foreground="{DynamicResource AccentLight}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <ProgressBar x:Name="ChecklistProgressBar"
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="6"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderBrush}"
                                     Margin="0,0,0,4"/>
                        <TextBlock x:Name="ChecklistSubText"
                                   Text="Open checklist to start your pre-stream setup"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Open Checklist →"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Click="OpenChecklist_Click"/>
                </Grid>
            </Border>

            <!-- Chart + Upcoming -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Viewer Chart -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Viewer Count" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <Canvas x:Name="ViewerChart" Height="160"
                                ClipToBounds="True" Background="Transparent"
                                Loaded="ViewerChart_Loaded" SizeChanged="ViewerChart_SizeChanged"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0m" Style="{StaticResource Muted}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="5m" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="10m" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="15m" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Upcoming Streams -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Upcoming Streams" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="View all" Foreground="{DynamicResource AccentLight}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Cursor="Hand"/>
                        </Grid>

                        <StackPanel x:Name="UpcomingList"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Launch -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Quick Launch" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Opens in browser tab" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Manage" Foreground="{DynamicResource AccentLight}"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Cursor="Hand"/>
                    </Grid>
                    <WrapPanel x:Name="QuickLaunchPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
