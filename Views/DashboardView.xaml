<UserControl x:Class="StreamCommand.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamCommand.Views"
             Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="*"/>     <!-- main content -->
        </Grid.RowDefinitions>

        <!-- Conversion card host — injected from code when StreamsCompleted >= 3 -->
        <StackPanel x:Name="ConversionCardHost" Grid.Row="0" Margin="20,16,20,0"/>

        <!-- ── Top bar ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,14,20,14" Background="{DynamicResource AppBackground}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageHeader}"/>
                    <TextBlock x:Name="TodayDate" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                </StackPanel>
                <Button Content="▶  Go Live"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,9" FontSize="13"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="GoLive_Click"/>
            </Grid>
        </Border>

        <!-- ── Main content: left column + right chat panel ────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Left column — Grid so Recent Events stretches to fill the screen -->
            <Grid Grid.Column="0" Margin="20,16,12,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- status bar -->
                    <RowDefinition Height="Auto"/>  <!-- two-card row -->
                    <RowDefinition Height="*"/>     <!-- recent events (fills) -->
                </Grid.RowDefinitions>

                    <!-- Stream Status Bar -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- OBS pill -->
                            <Border x:Name="OBSPill" Grid.Column="0"
                                    Background="#1a0a0a" BorderBrush="#EF4444"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="OBSPillDot" Width="6" Height="6"
                                             Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OBSPillText" Text="OBS Offline"
                                               Foreground="#EF4444" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Session timer -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SESSION" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="SessionTimerText" Text="—"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Viewers -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                <TextBlock Text="VIEWERS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LiveViewersText" Text="—"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Followers -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="FOLLOWERS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="FollowerCountText" Text="—"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- New followers today -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="NEW TODAY" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="NewFollowersTodayText" Text="—"
                                           Foreground="{DynamicResource AccentLight}"
                                           FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Two-card row: Checklist + Scene Control -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pre-Stream Checklist card -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Pre-Stream" Style="{StaticResource SectionHeader}"
                                                   FontSize="14" Margin="0,0,8,0"/>
                                        <Border x:Name="ChecklistBadge"
                                                Background="{DynamicResource AccentMuted}"
                                                BorderBrush="{DynamicResource AccentBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ChecklistBadgeText" Text="—"
                                                       Foreground="{DynamicResource AccentLight}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="Open →" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                                            Click="OpenChecklist_Click"/>
                                </Grid>

                                <!-- Ring progress -->
                                <Grid HorizontalAlignment="Center" Margin="0,4,0,10">
                                    <Ellipse Width="68" Height="68"
                                             Stroke="{DynamicResource BorderBrush}"
                                             StrokeThickness="5"/>
                                    <Ellipse x:Name="ChecklistRing" Width="68" Height="68"
                                             Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="5"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashOffset="0"/>
                                    <TextBlock x:Name="ChecklistPct" Text="0%"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryText}"
                                               FontSize="14" FontWeight="Bold"/>
                                </Grid>

                                <!-- Items -->
                                <StackPanel x:Name="ChecklistItemsPanel"/>

                                <TextBlock x:Name="ChecklistSubText"
                                           Text="Open checklist to start your pre-stream setup"
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Scene Control card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Scene Control" Style="{StaticResource SectionHeader}"
                                           FontSize="14" Margin="0,0,0,10"/>

                                <!-- Connected content — active scene + quick-switch buttons -->
                                <StackPanel x:Name="SceneConnectedContent" Visibility="Collapsed">
                                    <Border Background="{DynamicResource AccentMuted}"
                                            BorderBrush="{DynamicResource AccentBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="ActiveSceneText" Text="—"
                                                       Foreground="{DynamicResource AccentLight}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="SceneButtonsPanel"/>
                                </StackPanel>

                                <!-- Designed empty state — OBS not connected -->
                                <Border x:Name="SceneEmptyState"
                                        Background="{DynamicResource AccentMuted}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="3,0,0,0" CornerRadius="6"
                                        Padding="16,18">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Connect OBS to control your scenes"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <Button Content="Open Setup Guide"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6" FontSize="11"
                                                HorizontalAlignment="Center"
                                                Click="OpenSetup_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Events card — stretches to fill remaining height -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Recent Events" Style="{StaticResource SectionHeader}"
                                       FontSize="14" Margin="0,0,0,12"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RecentEventsPanel"/>
                            </ScrollViewer>

                            <!-- Centered designed empty state -->
                            <StackPanel Grid.Row="1" x:Name="RecentEventsEmpty"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="No automation events yet"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Follows, subs, and raids will appear here live as they happen."
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

            </Grid>

            <!-- Right: Live Chat panel -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource SidebarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="*"/>     <!-- message list -->
                        <RowDefinition Height="Auto"/>  <!-- input row -->
                    </Grid.RowDefinitions>

                    <!-- Chat header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,11">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ChatLiveDot" Width="7" Height="7"
                                     Fill="{DynamicResource MutedText}"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Chat" Foreground="{DynamicResource PrimaryText}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChatCountText" Text=""
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Message list -->
                    <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatMessagePanel" Margin="0,4,0,4"/>
                    </ScrollViewer>

                    <!-- Designed empty state — Twitch not connected -->
                    <Border Grid.Row="1" x:Name="ChatEmptyState"
                            Background="{DynamicResource AccentMuted}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="3,0,0,0" CornerRadius="6"
                            VerticalAlignment="Center" Margin="14" Padding="14,18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💬" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Connect Twitch to see live chat"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Button Content="Open Setup Guide"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" FontSize="11"
                                    HorizontalAlignment="Center"
                                    Click="OpenSetup_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Input row -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInputBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="8,6" FontSize="12"
                                     Tag="Send a message…"
                                     KeyDown="ChatInput_KeyDown"/>
                            <Button Grid.Column="1" Content="Send"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,6" Margin="6,0,0,0" FontSize="12"
                                    Click="ChatSend_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
