<UserControl x:Class="StreamCommand.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamCommand.Views"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="Auto"/>  <!-- conversion card (when shown) -->
            <RowDefinition Height="*"/>     <!-- main content -->
        </Grid.RowDefinitions>

        <!-- ── Top bar ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Height="76">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COMMAND CENTER" FontFamily="{DynamicResource CondensedFont}"
                               Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Dashboard" Foreground="{DynamicResource PrimaryText}" FontSize="26" FontWeight="Bold" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TodayDate" Foreground="{DynamicResource SecondaryText}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Background="{DynamicResource HeroAccentFill}"
                            Height="46" Padding="22,0" FontSize="15" FontWeight="Bold"
                            Click="GoLive_Click" AutomationProperties.Name="Go Live">
                        <Button.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" ShadowDepth="0" BlurRadius="22" Opacity="0.45"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBroadcast}" Style="{StaticResource StrokeIcon}"
                                  Stroke="{DynamicResource ButtonPrimaryFg}" StrokeThickness="2.8" Margin="0,0,10,0"/>
                            <TextBlock Text="GO LIVE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <!-- Accent hairline fading out to the right instead of a flat divider -->
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentHairline}"/>
        </Grid>

        <!-- Conversion card host — injected from code when StreamsCompleted >= 3 -->
        <StackPanel x:Name="ConversionCardHost" Grid.Row="1" Margin="24,16,24,0"/>

        <!-- ── Main content: left column + right chat panel ────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left column — Grid so Recent Events stretches to fill the screen -->
            <Grid Grid.Column="0" Margin="24,20,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- status bar -->
                    <RowDefinition Height="Auto"/>  <!-- two-card row -->
                    <RowDefinition Height="*"/>     <!-- recent events (fills) -->
                </Grid.RowDefinitions>

                <!-- ═══ HUD status strip — the numbers you glance at mid-game ═══ -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Border Style="{StaticResource HudCard}" CornerRadius="6" Padding="0" MinHeight="104">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <!-- OBS -->
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="22,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OBS STUDIO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left"/>
                                    <Border x:Name="OBSPill" Style="{StaticResource StatusPill}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="OBSPillDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="OBSPillText" Text="Offline" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Session timer -->
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="OnAirDot" Width="8" Height="8" Fill="{DynamicResource LiveBrush}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FF5A65" ShadowDepth="0" BlurRadius="10" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="SessionLabel" Text="SESSION" Style="{StaticResource SectionLabel}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SessionTimerText" Text="—" Style="{StaticResource MetricValue}" FontSize="36" FontWeight="Bold">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{DynamicResource AccentColor}" ShadowDepth="0" BlurRadius="16" Opacity="0.35"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Viewers -->
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VIEWERS" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="LiveViewersText" Text="—" Style="{StaticResource MetricValue}" FontSize="36" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Followers -->
                            <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FOLLOWERS" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="FollowerCountText" Text="—" Style="{StaticResource MetricValue}" FontSize="36" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- New followers today -->
                            <Border Grid.Column="4" Padding="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NEW TODAY" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="NewFollowersTodayText" Text="—" Style="{StaticResource MetricValue}" FontSize="36" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentLight}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- HUD corner ticks -->
                    <Path Style="{StaticResource HudTick}" Data="M1,14 L1,1 L14,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"/>
                    <Path Style="{StaticResource HudTick}" Data="M0,1 L13,1 L13,14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
                    <Path Style="{StaticResource HudTick}" Data="M1,0 L1,13 L14,13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3"/>
                    <Path Style="{StaticResource HudTick}" Data="M0,13 L13,13 L13,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                </Grid>

                <!-- Two-card row: Checklist + Scene Control -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pre-Stream Checklist card -->
                    <Border Grid.Column="0" Style="{StaticResource HudCard}" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Style="{StaticResource HudDiamond}"/>
                                    <TextBlock Text="PRE-STREAM CHECKLIST" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,10,0"/>
                                    <Border x:Name="ChecklistBadge"
                                            Background="{DynamicResource AccentMuted}"
                                            BorderBrush="{DynamicResource AccentBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="7,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ChecklistBadgeText" Text="—"
                                                   Foreground="{DynamicResource AccentLight}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <Button Content="Open →" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                                        Click="OpenChecklist_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ring progress (dash maths in ProgressRingMath) -->
                                <Grid Width="120" Height="120" Margin="0,0,24,0" VerticalAlignment="Top">
                                    <Ellipse Stroke="{DynamicResource InsetBackground}" StrokeThickness="10"/>
                                    <Ellipse Stroke="{DynamicResource RaisedBackground}" StrokeThickness="1" Margin="12"/>
                                    <Ellipse x:Name="ChecklistRing"
                                             Stroke="{DynamicResource RingGradient}"
                                             StrokeThickness="10"
                                             StrokeDashCap="Round"
                                             StrokeDashArray="0 100"
                                             Visibility="Hidden"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource AccentColor}" ShadowDepth="0" BlurRadius="14" Opacity="0.6"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="ChecklistPct" Text="0%" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="READY" FontFamily="{DynamicResource CondensedFont}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Items -->
                                    <StackPanel x:Name="ChecklistItemsPanel"/>
                                    <TextBlock x:Name="ChecklistSubText"
                                               Text="Open the checklist to start your pre-stream setup"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="15" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Scene Control card -->
                    <Border Grid.Column="2" Style="{StaticResource HudCard}" Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <Rectangle Style="{StaticResource HudDiamond}"/>
                                <TextBlock Text="SCENE CONTROL" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>

                            <!-- Connected content — what's on program + quick-switch tiles -->
                            <StackPanel x:Name="SceneConnectedContent" Visibility="Collapsed">
                                <Border BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="10"
                                        Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource ProPaneGradient}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="ON PROGRAM" FontFamily="{DynamicResource CondensedFont}"
                                                       Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock x:Name="ActiveSceneText" Text="—"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       FontSize="24" FontWeight="Bold" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource LiveBrush}" CornerRadius="4" Padding="7,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="PROGRAM" FontFamily="{DynamicResource CondensedFont}"
                                                       Foreground="{DynamicResource OnLiveFg}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <UniformGrid x:Name="SceneButtonsPanel" Columns="2" Margin="0,0,-8,-8"/>
                            </StackPanel>

                            <!-- Designed empty state — OBS not connected -->
                            <StackPanel x:Name="SceneEmptyState" HorizontalAlignment="Center" Margin="0,4,0,4">
                                <Border Width="68" Height="68" CornerRadius="34" HorizontalAlignment="Center"
                                        Background="{DynamicResource InsetBackground}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" ShadowDepth="0" BlurRadius="20" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Path Data="{StaticResource IconPlug}" Style="{StaticResource StrokeIcon}"
                                          Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                                        <Path.LayoutTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></Path.LayoutTransform>
                                    </Path>
                                </Border>
                                <TextBlock Text="Connect OBS to control your scenes"
                                           Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="Bold"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,4"/>
                                <TextBlock Text="Switch scenes from here without alt-tabbing out of your game."
                                           Foreground="{DynamicResource SecondaryText}" FontSize="13"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,14"/>
                                <Button Content="Connect OBS" Style="{StaticResource PrimaryButton}"
                                        Height="40" Padding="20,0" HorizontalAlignment="Center" FontWeight="Bold"
                                        Click="OpenSetup_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Events card — stretches to fill remaining height -->
                <Border Grid.Row="2" Style="{StaticResource HudCard}" Padding="20,16,20,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource HudDiamond}"/>
                                <TextBlock Text="RECENT EVENTS" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource FollowBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Follow" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,14,0"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SubBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sub" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,14,0"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BitsBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bits" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RecentEventsPanel"/>
                        </ScrollViewer>

                        <!-- Centered designed empty state -->
                        <StackPanel Grid.Row="1" x:Name="RecentEventsEmpty"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="{DynamicResource InsetBackground}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                                <Path Data="{StaticResource IconBolt}" Style="{StaticResource StrokeIcon}"
                                      Stroke="{DynamicResource AccentLight}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No events yet"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Follows, subs and bits appear here live as they happen."
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <!-- Right: Live Chat panel -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource ChatPanelBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="*"/>     <!-- message list -->
                        <RowDefinition Height="Auto"/>  <!-- input row -->
                    </Grid.RowDefinitions>

                    <!-- Chat header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="18,0" Height="56">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ChatLiveDot" Width="8" Height="8"
                                         Fill="{DynamicResource MutedText}"
                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE CHAT" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="ChatCountText" Text=""
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Message list -->
                    <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatMessagePanel" Margin="0,10,0,10"/>
                    </ScrollViewer>

                    <!-- Designed empty state — Twitch not connected -->
                    <StackPanel Grid.Row="1" x:Name="ChatEmptyState"
                                VerticalAlignment="Center" Margin="24,0">
                        <Border Width="60" Height="60" CornerRadius="16" HorizontalAlignment="Center"
                                Background="{DynamicResource SubMuted}" BorderBrush="{DynamicResource SubBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#A970FF" ShadowDepth="0" BlurRadius="20" Opacity="0.35"/>
                            </Border.Effect>
                            <Path Data="{StaticResource IconTwitch}" Style="{StaticResource StrokeIcon}"
                                  Stroke="{DynamicResource TwitchIconBrush}" HorizontalAlignment="Center">
                                <Path.LayoutTransform><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Path.LayoutTransform>
                            </Path>
                        </Border>
                        <TextBlock Text="Connect Twitch to see live chat"
                                   Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,6"/>
                        <TextBlock Text="Read and reply to chat, and see follows and subs in your events feed."
                                   Foreground="{DynamicResource SecondaryText}" FontSize="13" LineHeight="19"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button Content="Connect Twitch" Style="{StaticResource PrimaryButton}"
                                Height="44" FontSize="14" FontWeight="Bold"
                                Click="OpenSetup_Click"/>
                    </StackPanel>

                    <!-- Input row -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInputBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="10,0" Height="44" FontSize="14"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Chat message"
                                     KeyDown="ChatInput_KeyDown"/>
                            <Button Grid.Column="1" Content="Send"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44" Padding="16,0" Margin="8,0,0,0" FontSize="14" FontWeight="Bold"
                                    Click="ChatSend_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
