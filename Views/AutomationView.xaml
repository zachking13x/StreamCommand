<UserControl x:Class="StreamCommand.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StreamCommand.Models"
             Background="{DynamicResource AppBackground}">

    <UserControl.Resources>
        <DataTemplate x:Key="RuleTemplate" DataType="{x:Type models:AutomationRule}">
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Trigger}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontSize="13" FontWeight="Medium"/>
                        <TextBlock FontSize="12" Margin="0,3,0,0">
                            <Run Text="→ " Foreground="{DynamicResource MutedText}"/>
                            <Run Text="{Binding Action, Mode=OneWay}" Foreground="{DynamicResource SecondaryText}"/>
                        </TextBlock>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Automation" Style="{StaticResource SectionHeader}" FontSize="18"/>
                <TextBlock Text="Set up automatic responses and actions for stream events"
                           Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="+ New Rule"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Rules by Category -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoriesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Category}"
                                               Style="{StaticResource SectionHeader}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rules}"
                                              ItemTemplate="{StaticResource RuleTemplate}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
