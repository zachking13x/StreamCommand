<UserControl x:Class="StreamCommand.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StreamCommand.Models"
             Background="{DynamicResource AppBackground}">

    <UserControl.Resources>
        <DataTemplate x:Key="RuleTemplate" DataType="{x:Type models:AutomationRule}">
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Trigger}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontSize="13" FontWeight="Medium"/>
                        <TextBlock FontSize="12" Margin="0,3,0,0">
                            <Run Text="→ " Foreground="{DynamicResource MutedText}"/>
                            <Run Text="{Binding Action, Mode=OneWay}" Foreground="{DynamicResource SecondaryText}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ResponseTemplate, Mode=OneWay}"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="11" FontStyle="Italic"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Automation" Style="{StaticResource SectionHeader}" FontSize="18"/>
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Rules fire automatically through your connected Twitch Chat Token in real time. Toggle any rule on or off — changes save instantly."/>
                <Border x:Name="FreeLimitBanner" Visibility="Collapsed"
                        Background="#1A0F3A" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒  Free plan: 3 active rules max. "
                                   Foreground="{DynamicResource AccentLight}" FontSize="12"/>
                        <TextBlock Text="Upgrade to Pro for unlimited rules →"
                                   Foreground="{DynamicResource AccentLight}" FontSize="12"
                                   FontWeight="SemiBold" Cursor="Hand"
                                   MouseLeftButtonUp="UpgradeBanner_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="NewRuleButton"
                    Content="+ New Rule"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="NewRule_Click"/>
        </Grid>

        <!-- ── New Rule Form (hidden until + New Rule is clicked) ── -->
        <Border x:Name="NewRuleForm"
                Grid.Row="1"
                Style="{StaticResource Card}"
                Visibility="Collapsed"
                Margin="0,0,0,14"
                BorderBrush="{DynamicResource AccentBorder}">
            <StackPanel>
                <TextBlock Text="New Rule" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                <!-- Trigger type + optional command keyword -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TRIGGER" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TriggerTypeCombo"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="TriggerTypeCombo_SelectionChanged">
                            <ComboBoxItem Tag="NewSubscriber">New Subscriber</ComboBoxItem>
                            <ComboBoxItem Tag="Resub">Re-subscription</ComboBoxItem>
                            <ComboBoxItem Tag="GiftSub">Gift Sub</ComboBoxItem>
                            <ComboBoxItem Tag="Raid">Raid Received</ComboBoxItem>
                            <ComboBoxItem Tag="ChatCommand">Chat Command (!keyword)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Only visible for ChatCommand trigger -->
                    <StackPanel x:Name="CommandKeywordPanel" Grid.Column="2" Visibility="Collapsed">
                        <TextBlock Text="COMMAND KEYWORD (e.g. !socials)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CommandKeywordInput" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Response template -->
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4">
                    <Run Text="RESPONSE  "/>
                    <Run Text="(@user, @raider, {months} supported)" Foreground="{DynamicResource MutedText}"/>
                </TextBlock>
                <TextBox x:Name="ResponseInput"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Rule" Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Click="SaveNewRule_Click"/>
                    <Button Content="Cancel"    Style="{StaticResource SecondaryButton}"
                            Padding="12,8" Margin="8,0,0,0" Click="CancelNewRule_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Rules by Category ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoriesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Category}"
                                               Style="{StaticResource SectionHeader}"
                                               FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rules}"
                                              ItemTemplate="{StaticResource RuleTemplate}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
