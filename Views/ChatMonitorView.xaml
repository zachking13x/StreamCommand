<UserControl x:Class="StreamCommand.Views.ChatMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Chat Monitor" Style="{StaticResource SectionHeader}" FontSize="18"/>
                <TextBlock Text="Live chat preview — connect Twitch or YouTube in Settings to see real messages"
                           Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="Open in Twitch ↗"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OpenTwitch_Click"/>
        </Grid>

        <!-- Filter Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="FilterAll"    Content="All Messages" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Filter_Click" Tag="all"/>
            <Button x:Name="FilterSubs"   Content="⭐ Subs Only"  Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Filter_Click" Tag="subs"/>
            <Button x:Name="FilterHighlight" Content="♥ Highlighted" Style="{StaticResource SecondaryButton}" Click="Filter_Click" Tag="highlighted"/>
        </StackPanel>

        <!-- Chat Feed -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0"
                Margin="0,0,0,12"
                ClipToBounds="True">
            <ScrollViewer x:Name="ChatScroller"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0">
                <ItemsControl x:Name="ChatList" Padding="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="4" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock Text="{Binding Time}"
                                               Foreground="{DynamicResource MutedText}"
                                               FontSize="11"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Width="55"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="12"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding UserColored}"
                                               Foreground="{Binding UserColor}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Connect Banner -->
        <Border x:Name="ConnectBanner"
                Grid.Row="3"
                Background="#1A0F3A"
                BorderBrush="{DynamicResource AccentBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Connect your accounts for live chat"
                               Foreground="{DynamicResource AccentLight}"
                               FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConnectStatusText"
                               Text="Add your Twitch Chat Token in Settings, then reopen this page"
                               Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="Go to Settings"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="14,7"
                        Click="GoToSettings_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
