<UserControl x:Class="StreamCommand.Views.ChatMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Chat Monitor" Style="{StaticResource SectionHeader}" FontSize="18"/>
                <TextBlock Text="Live chat preview — connect Twitch or YouTube in Settings to see real messages"
                           Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="Open in Twitch ↗"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OpenTwitch_Click"/>
        </Grid>

        <!-- Filter Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="FilterAll"    Content="All Messages" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Filter_Click" Tag="all"/>
            <Button x:Name="FilterSubs"   Content="⭐ Subs Only"  Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Filter_Click" Tag="subs"/>
            <Button x:Name="FilterHighlight" Content="♥ Highlighted" Style="{StaticResource SecondaryButton}" Click="Filter_Click" Tag="highlighted"/>
        </StackPanel>

        <!-- Chat Feed -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0"
                Margin="0,0,0,12"
                ClipToBounds="True">
            <ScrollViewer x:Name="ChatScroller"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0">
                <ItemsControl x:Name="ChatList" Padding="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="4" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock Text="{Binding Time}"
                                               Foreground="{DynamicResource MutedText}"
                                               FontSize="11"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Width="55"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="12"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding UserColored}"
                                               Foreground="{Binding UserColor}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Commands Panel (right column, spans all rows) -->
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14">
            <StackPanel>
                <TextBlock Text="CHAT COMMANDS" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource MutedText}" Margin="0,0,0,10"/>
                <TextBlock Text="Auto-respond when viewers type these commands"
                           Foreground="{DynamicResource MutedText}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Command list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                    <StackPanel x:Name="CommandsPanel"/>
                </ScrollViewer>

                <!-- Add command form -->
                <Border x:Name="AddCommandForm" Visibility="Collapsed"
                        Background="{DynamicResource AppBackground}"
                        BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Trigger (e.g. !discord)" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewTriggerBox" FontSize="12" Padding="6,5" Margin="0,0,0,8"
                                 Background="{DynamicResource CardBackground}"
                                 Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Response" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewResponseBox" FontSize="12" Padding="6,5" Margin="0,0,0,10"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 Background="{DynamicResource CardBackground}"
                                 Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save" Padding="0,6"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveCommand_Click"/>
                            <Button Grid.Column="2" Content="Cancel" Padding="0,6"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CancelCommand_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="+ Add Command" Margin="0,10,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Padding="0,8" Click="AddCommand_Click"/>
            </StackPanel>
        </Border>

        <!-- Connect Banner -->
        <Border x:Name="ConnectBanner"
                Grid.Row="3"
                Background="#1A0F3A"
                BorderBrush="{DynamicResource AccentBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Connect Twitch to see live chat"
                               Foreground="{DynamicResource AccentLight}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="1  " Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Settings → API Keys → paste your " Foreground="{DynamicResource MutedText}" FontSize="12"/>
                        <TextBlock Text="Twitch Chat Token" Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="2  " Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConnectStatusText"
                                   Text="Return here — chat connects automatically"
                                   Foreground="{DynamicResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open Settings →"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        Click="GoToSettings_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
