<Window x:Class="StreamCommand.Views.StreamSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Summary"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ShowActivated="True">

    <Border Padding="36,32">
        <StackPanel>
            <!-- Headline -->
            <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Great stream!" TextAlignment="Center"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubHeadline" TextAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="13" Margin="0,0,0,28" TextWrapping="Wrap"/>

            <!-- Stats grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Duration -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="DURATION" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DurationText" Text="—"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Automations fired -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="AUTOMATION FIRED" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AutomationsText" Text="0"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button Content="See full analytics"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,9" Margin="0,0,10,0"
                        Click="ViewAnalytics_Click"/>
                <Button Content="Done"
                        Style="{StaticResource PrimaryButton}"
                        Padding="24,9"
                        Click="Done_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
