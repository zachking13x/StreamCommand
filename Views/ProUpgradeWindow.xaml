<Window x:Class="StreamCommand.Views.ProUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Command Pro"
        Width="680" Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,32">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="✨" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Stream Command Pro" TextAlignment="Center"
                           Foreground="{DynamicResource PrimaryText}" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Everything you need to grow your stream — one price, no surprises."
                           TextAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Pricing cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monthly -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,20">
                    <StackPanel>
                        <TextBlock Text="Monthly" Foreground="{DynamicResource MutedText}"
                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <TextBlock Text="$" Foreground="{DynamicResource PrimaryText}" FontSize="16"
                                       FontWeight="Bold" Margin="0,6,1,0" VerticalAlignment="Top"/>
                            <TextBlock Text="6.99" Foreground="{DynamicResource PrimaryText}"
                                       FontSize="36" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="per month · cancel anytime" Foreground="{DynamicResource MutedText}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,16"/>
                        <Button x:Name="MonthlyBtn" Content="Choose Monthly"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,8" Click="Monthly_Click"/>
                    </StackPanel>
                </Border>

                <!-- Annual — BEST VALUE -->
                <Border Grid.Column="2" BorderThickness="2" CornerRadius="12" Padding="16,20"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Background="{DynamicResource AccentMuted}">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="20"
                                Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="BEST VALUE  ·  SAVE 40%" Foreground="White"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Annual" Foreground="{DynamicResource AccentLight}"
                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="$" Foreground="{DynamicResource PrimaryText}" FontSize="16"
                                       FontWeight="Bold" Margin="0,6,1,0" VerticalAlignment="Top"/>
                            <TextBlock Text="49.99" Foreground="{DynamicResource PrimaryText}"
                                       FontSize="36" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="per year  ($4.17/mo)" Foreground="{DynamicResource MutedText}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,16"/>
                        <Button x:Name="AnnualBtn" Content="Choose Annual"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,8" Click="Annual_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Launch promo — Lifetime (time-limited, retiring soon) -->
            <Border Background="#0F1A10" BorderBrush="#4ADE80"
                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#166534" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="🚀 LAUNCH SPECIAL" Foreground="#86EFAC"
                                           FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="Retiring after launch window" Foreground="#86EFAC"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="Lifetime access" FontWeight="SemiBold" Foreground="White"/>
                            <Run Text=" — one payment, no recurring fees. Available at launch pricing only."/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="$" Foreground="White" FontSize="13" FontWeight="Bold"
                                       Margin="0,4,1,0" VerticalAlignment="Top"/>
                            <TextBlock Text="89.99" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                        <Button x:Name="LifetimeBtn" Content="Get Lifetime Access"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,6,0,0"
                                Click="Lifetime_Click"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Social proof -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="⭐⭐⭐⭐⭐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="Trusted by"/>
                        <Run Text=" 2,000+ streamers" Foreground="{DynamicResource AccentLight}" FontWeight="SemiBold"/>
                        <Run Text=" on Windows"/>
                    </TextBlock>
                </StackPanel>

                <!-- Testimonial 1 -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" MaxWidth="560">
                    <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" FontStyle="Italic"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="&quot;Finally replaced Nightbot — automation just works. Raids, subs, custom commands, all in one place.&quot;"/>
                </Border>

                <!-- Testimonial 2 -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,0" MaxWidth="560">
                    <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" FontStyle="Italic"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="&quot;The OBS integration alone is worth it for solo streamers. I cut my setup time in half.&quot;"/>
                </Border>
            </StackPanel>

            <!-- Feature comparison -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Free" Foreground="{DynamicResource MutedText}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Pro ✨" Foreground="{DynamicResource AccentLight}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Row helper: feature name + outcome statement -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,8,0,8">
                        <TextBlock Text="Dashboard &amp; Live Control" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Go live, manage OBS scenes, and track stream time — all in one place." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,8,0,8">
                        <TextBlock Text="Twitch Chat Monitor &amp; Commands" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Read live chat and auto-respond to viewer commands instantly." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,8,0,8">
                        <TextBlock Text="Pre-Stream Checklist" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Never forget a mic check or title update — launch every stream prepared." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="3" Text="View only" Foreground="{DynamicResource MutedText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Width="60"/>
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,8,0,8">
                        <TextBlock Text="Stream Planner — unlimited streams" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Schedule future streams with dates, times, and notes so you never go in unprepared." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="4" Text="3 streams" Foreground="{DynamicResource MutedText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Width="60"/>
                    <TextBlock Grid.Column="2" Grid.Row="4" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="5" Margin="0,8,0,8">
                        <TextBlock Text="Analytics — 30-day history" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="See follower growth, peak viewers, and stream hours to know what's actually working." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="5" Text="Live only" Foreground="{DynamicResource MutedText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Width="60"/>
                    <TextBlock Grid.Column="2" Grid.Row="5" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="6" Margin="0,8,0,8">
                        <TextBlock Text="Automation Rules — unlimited" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Auto-greet followers, alert on raids, celebrate milestones — runs while you focus on the stream." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="6" Text="3 rules" Foreground="{DynamicResource MutedText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="6" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="7" Margin="0,8,0,8">
                        <TextBlock Text="Multi-platform (Twitch + YouTube)" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Manage both platforms from one dashboard — grow on two channels simultaneously." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="7" Text="—" Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="7" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="8" Margin="0,8,0,8">
                        <TextBlock Text="Unlimited Quick-Launch shortcuts" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="One click to open OBS, Discord, Streamlabs, or any app you use mid-stream." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="8" Text="5 apps" Foreground="{DynamicResource MutedText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="8" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="9" Margin="0,8,0,8">
                        <TextBlock Text="Stream Alert Overlay" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="On-screen toasts for follows, subs, and raids — always on top, no separate app needed." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="9" Text="—" Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="9" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="0" Grid.Row="10" Margin="0,8,0,0">
                        <TextBlock Text="Priority support" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="Get faster answers directly from the developer when something breaks." Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="10" Text="—" Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="10" Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Store note -->
            <Border Background="#0F1B2D" BorderBrush="{DynamicResource AccentBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"
                           Text="🔒  Payments are processed securely through the Microsoft Store. Stream Command never handles your payment details directly. Cancel anytime — no questions asked."/>
            </Border>

            <!-- Close -->
            <Button Content="Maybe Later"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center"
                    Padding="20,8"
                    Click="Close_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
