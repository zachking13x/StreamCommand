<Window x:Class="StreamCommand.Views.ProUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Command Pro"
        Width="1000" Height="680"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Scrolls only when WindowFit shrank the window below its design size (high display scaling). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <!-- Shadow lives on a sibling: an Effect on the content border would drop ClearType on every glyph inside it. -->
        <Border CornerRadius="18" Background="{DynamicResource ModalBackground}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Root" CornerRadius="18" ClipToBounds="True"
                Background="{DynamicResource ModalBackground}"
                BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: the pitch ── -->
                <Border Grid.Column="0" Background="{DynamicResource ProPaneGradient}" CornerRadius="17,0,0,17" Padding="40,40,40,32">
                    <StackPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="9,3" HorizontalAlignment="Left">
                            <TextBlock Text="STREAM COMMAND PRO" FontFamily="{DynamicResource CondensedFont}"
                                       Foreground="{DynamicResource ButtonPrimaryFg}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Take full control&#x0a;of your stream" Margin="0,14,0,0"
                                   Foreground="{DynamicResource PrimaryText}" FontSize="36" FontWeight="SemiBold" LineHeight="40"/>
                        <!-- Personalized from usage; falls back to the positioning line. -->
                        <TextBlock x:Name="DynamicHeadline" Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="15" TextWrapping="Wrap" LineHeight="22"/>

                        <!-- Unlocks — ordered by want, shrinking in weight; analytics last and smallest. -->
                        <StackPanel Margin="0,28,0,0">
                            <!-- 1 — Live preview (hero) -->
                            <Border Background="{DynamicResource AccentMuted}" BorderBrush="{DynamicResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,16,0">
                                        <Path Data="{StaticResource IconMonitor}" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource ButtonPrimaryFg}" HorizontalAlignment="Center">
                                            <Path.LayoutTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.LayoutTransform>
                                        </Path>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Live preview" Foreground="{DynamicResource PrimaryText}" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock Text="See exactly what viewers see, right inside the app" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SecondaryText}" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 2 — On-stream alerts -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource RaisedBackground}"
                                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconBell}" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource AccentLight}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="On-stream alerts" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Follower and sub alerts, shown on your broadcast" Foreground="{DynamicResource SecondaryText}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 3 — Unlimited automation -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource RaisedBackground}"
                                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconBolt}" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource AccentLight}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Unlimited automation" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Free includes 1 rule" Foreground="{DynamicResource SecondaryText}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 4 — Scheduled streams -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,14">
                                <Border Width="40" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconCalendar}" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource MutedText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Unlimited scheduled streams" Foreground="{DynamicResource PrimaryText}" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 5 — Analytics history (smallest, last) -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                <Border Width="40" Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconBars}" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource MutedText}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center"><Run Text="Analytics history"/><Run Text="  · coming soon" Foreground="{DynamicResource MutedText}" FontSize="12"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Right: plans ── -->
                <Border Grid.Column="1" Background="{DynamicResource ModalSideBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                        CornerRadius="0,17,17,0" Padding="32,40,32,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ONE-TIME PURCHASE" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>

                        <StackPanel Grid.Row="1">
                            <!-- One price, no plans, no add-ons: buying the app unlocks everything. -->
                            <Border Background="{DynamicResource ModalBackground}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="22,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AppPrice" Text="$7.99" FontSize="40" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="once" FontSize="15" Foreground="{DynamicResource SecondaryText}"
                                                   Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="Yours forever. No subscription and no tiers - every feature is included."
                                               FontSize="14" Foreground="{DynamicResource SecondaryText}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Trial countdown - only while the Store reports an active trial -->
                            <Border x:Name="TrialPanel" Visibility="Collapsed"
                                    Background="{DynamicResource AccentMuted}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"
                                    CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                                <TextBlock x:Name="TrialStatus" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="3" x:Name="PurchaseStatus" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnAirText}" FontSize="13" Margin="0,0,0,10"/>

                        <Button Grid.Row="4" x:Name="UpgradeBtn" Content="Buy Stream Command" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" Background="{DynamicResource HeroAccentFill}"
                                Height="54" FontSize="17" FontWeight="Bold" Click="Upgrade_Click"/>

                        <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Billed through your Microsoft Store account." HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                            <Button x:Name="RestoreBtn" Content="Restore purchase" HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,4"
                                    Foreground="{DynamicResource AccentLight}" FontSize="12" Click="Restore_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Style="{StaticResource GhostIconButton}" IsCancel="True"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                        AutomationProperties.Name="Close" Click="Close_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
