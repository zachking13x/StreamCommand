<UserControl x:Class="StreamCommand.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StreamCommand.Models"
             Background="{DynamicResource AppBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="EventTemplate" DataType="{x:Type models:StreamEvent}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                    Opacity="{Binding CardOpacity}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date block -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateDisplay}"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DayNumber}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" LineHeight="32"/>
                        <TextBlock Text="{Binding DayDisplay}"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Margin="12,4"/>

                    <!-- Info -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PastLabel}"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Background="{Binding PlatformBadgeColor}">
                                <TextBlock Text="{Binding Platform}"
                                           Foreground="{Binding PlatformTextColor}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center">
                                <Run Text="🕐  "/>
                                <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding Duration, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Notes}"
                                   Style="{StaticResource Muted}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Delete -->
                    <Button Grid.Column="3"
                            Content="✕"
                            Tag="{Binding}"
                            Foreground="{DynamicResource MutedText}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Click="Delete_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Stream Planner" Style="{StaticResource SectionHeader}" FontSize="18"/>
                <TextBlock Text="Schedule and manage upcoming streams"
                           Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="+ Schedule Stream"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="AddStream_Click"/>
        </Grid>

        <!-- Add Form -->
        <Border x:Name="AddForm"
                Grid.Row="1"
                Style="{StaticResource Card}"
                Visibility="Collapsed"
                Margin="0,0,0,14"
                BorderBrush="{DynamicResource AccentBorder}">
            <StackPanel>
                <TextBlock Text="New Stream" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleInput"      Grid.Column="0" Style="{StaticResource ModernTextBox}"/>
                    <DatePicker x:Name="DateInput"    Grid.Column="2"
                                Background="{DynamicResource InputBackground}"
                                Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="4"/>
                    <TextBox x:Name="TimeInput"       Grid.Column="4" Style="{StaticResource ModernTextBox}"/>
                    <ComboBox x:Name="PlatformInput"  Grid.Column="6" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                        <ComboBoxItem>Twitch</ComboBoxItem>
                        <ComboBoxItem>YouTube</ComboBoxItem>
                        <ComboBoxItem>Both</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="Title" Foreground="{DynamicResource MutedText}" FontSize="11"
                               IsHitTestVisible="False" Margin="2,0,0,0" Grid.Column="0"/>
                </Grid>
                <TextBox x:Name="NotesInput" Style="{StaticResource ModernTextBox}" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save"   Style="{StaticResource PrimaryButton}"   Padding="18,8" Click="SaveStream_Click"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0" Click="CancelAdd_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Event List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EventList" ItemTemplate="{StaticResource EventTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
