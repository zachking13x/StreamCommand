<UserControl x:Class="StreamCommand.Views.ProGateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="#1A0F3A"
            BorderBrush="{DynamicResource AccentBorder}"
            BorderThickness="1" CornerRadius="8" Padding="12,9"
            Cursor="Hand"
            MouseLeftButtonUp="Banner_Click">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🔒" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="SemiBold"
                           Text="{Binding FeatureLabel, ElementName=Root}"/>
                <TextBlock FontSize="11" Margin="0,1,0,0">
                    <Run Foreground="{DynamicResource MutedText}" Text="Available on Pro. "/>
                    <Run Foreground="{DynamicResource AccentLight}" FontWeight="SemiBold"
                         Text="Upgrade to unlock →"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
