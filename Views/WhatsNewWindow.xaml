<Window x:Class="StreamCommand.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New in Stream Command"
        Width="520" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="📣  What's New" Foreground="{DynamicResource PrimaryText}"
                           FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Recent updates and improvements to Stream Command"
                           Foreground="{DynamicResource MutedText}" FontSize="13"/>
            </StackPanel>

            <!-- v1.0.2 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{DynamicResource AccentBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="v1.0.2" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="May 2026  ·  Latest release"
                                   Foreground="{DynamicResource MutedText}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="✨  " Foreground="{DynamicResource AccentLight}"/>
                            <Run Text="YouTube integration" FontWeight="SemiBold"/>
                            <Run Text=" — add your YouTube Channel ID and API key in Settings"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="🔒  " Foreground="{DynamicResource AccentLight}"/>
                            <Run Text="Smarter paywalls" FontWeight="SemiBold"/>
                            <Run Text=" — Analytics, Automation, and Planner now enforce free tier limits with clear upgrade prompts"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="📋  " Foreground="{DynamicResource AccentLight}"/>
                            <Run Text="Dashboard checklist card" FontWeight="SemiBold"/>
                            <Run Text=" — see your pre-stream progress at a glance, every session"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="🔴  " Foreground="{DynamicResource AccentLight}"/>
                            <Run Text="OBS status pill" FontWeight="SemiBold"/>
                            <Run Text=" — the dashboard now shows a live connected/disconnected indicator"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="📅  " Foreground="{DynamicResource AccentLight}"/>
                            <Run Text="Dynamic planner dates" FontWeight="SemiBold"/>
                            <Run Text=" — past streams are visually de-emphasized; new streams default to future dates"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- v1.0.1 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource CardBackgroundAlt}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="v1.0.1" Foreground="{DynamicResource MutedText}"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="May 2026  ·  Pricing update"
                                   Foreground="{DynamicResource MutedText}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="💰  "/>
                            <Run Text="New pricing" FontWeight="SemiBold"/>
                            <Run Text=" — monthly $6.99, annual $49.99 (40% off), and a Launch Special lifetime tier"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="⚙️  "/>
                            <Run Text="Setup wizard" FontWeight="SemiBold"/>
                            <Run Text=" — 5-step onboarding now walks you through Twitch, OBS, and YouTube"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="12" Margin="0,3,0,3">
                            <Run Text="🔐  "/>
                            <Run Text="Privacy clarity" FontWeight="SemiBold"/>
                            <Run Text=" — Settings now shows exactly where your keys are stored and why"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- v1.0.0 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24" Opacity="0.65">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource CardBackgroundAlt}" CornerRadius="6"
                                Padding="8,3" Margin="0,0,10,0">
                            <TextBlock Text="v1.0.0" Foreground="{DynamicResource MutedText}"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="May 2026  ·  Initial release"
                                   Foreground="{DynamicResource MutedText}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12"
                               Text="First public release — Dashboard, Live Control, Chat Monitor, Automation, Planner, Analytics, Growth, and Quick Launch."/>
                </StackPanel>
            </Border>

            <!-- Feedback CTA -->
            <Border Background="#0F1B2D" BorderBrush="{DynamicResource AccentBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap">
                    <Run Text="💡  "/>
                    <Run Text="Have feedback or a feature request? " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                    <Run Text="Leave a review on the Microsoft Store or reach out — your input shapes what gets built next."/>
                </TextBlock>
            </Border>

            <Button Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center"
                    Padding="24,8"
                    Click="Close_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
