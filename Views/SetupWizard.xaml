<Window x:Class="StreamCommand.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Command — First-Time Setup"
        Width="620" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Step Indicator (5 steps) ══ -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,18">

                <Border x:Name="Dot1" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle Width="36" Height="2" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="4,0"/>

                <Border x:Name="Dot2" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BorderBrush}">
                    <TextBlock x:Name="Dot2Text" Text="2" Foreground="{DynamicResource MutedText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle x:Name="Line2" Width="36" Height="2" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="4,0"/>

                <Border x:Name="Dot3" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BorderBrush}">
                    <TextBlock x:Name="Dot3Text" Text="3" Foreground="{DynamicResource MutedText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle x:Name="Line3" Width="36" Height="2" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="4,0"/>

                <Border x:Name="Dot4" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BorderBrush}">
                    <TextBlock x:Name="Dot4Text" Text="4" Foreground="{DynamicResource MutedText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle x:Name="Line4" Width="36" Height="2" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="4,0"/>

                <Border x:Name="Dot5" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BorderBrush}">
                    <TextBlock x:Name="Dot5Text" Text="5" Foreground="{DynamicResource MutedText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
            <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"/>
        </StackPanel>

        <!-- ══ Content ══ -->
        <Grid Grid.Row="1" Margin="60,0">

            <!-- STEP 1 — Welcome -->
            <StackPanel x:Name="Step1" Visibility="Visible" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,20"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="▶" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Welcome to Stream Command" TextAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Your all-in-one streaming companion — chat alerts, OBS control, and analytics in one place."/>
                <TextBlock TextAlignment="Center" Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,22"
                           Text="Takes about 2 minutes to set up. You can skip any step and come back later in Settings."/>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟣" FontSize="18" Width="30" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Connect Twitch Chat" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="See live chat, sub alerts, and raids in the app" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="🎬" FontSize="18" Width="30" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Connect OBS Studio" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Start and stop your stream directly from Stream Command" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="🔴" FontSize="18" Width="30" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Connect YouTube (optional)" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="See YouTube stats alongside Twitch — manage both platforms" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="🚀" FontSize="18" Width="30" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Go Live with one click" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Dashboard, Planner, Checklist, Analytics — all wired up" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- STEP 2 — Connect Twitch (OAuth) -->
            <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="🟣  Connect Twitch" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,22"
                           Text="Sign in with your Twitch account to enable live chat, follower alerts, subscriber notifications, and channel stats."/>

                <!-- Connect button -->
                <Button x:Name="ConnectTwitchBtn"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,12" FontSize="14" FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,14"
                        Click="ConnectTwitch_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟣" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Connect with Twitch" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Connected state banner (hidden until auth succeeds) -->
                <Border x:Name="TwitchConnectedBanner"
                        Visibility="Collapsed"
                        Background="#0D2A1A" BorderBrush="#22C55E"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#22C55E" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TwitchConnectedText"
                                   Foreground="#86EFAC" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- What we request -->
                <Border Background="#1A0F3A" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Stream Command will request access to:" Foreground="{DynamicResource AccentLight}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="·  Read and send chat messages" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="·  Subscriber and follower event notifications" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="·  Channel point redemptions" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Your token is saved only on this PC — never transmitted to any server."
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="You can skip this and connect later in Settings."
                           Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- STEP 3 — OBS WebSocket -->
            <StackPanel x:Name="Step3" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="🎬  Connect OBS Studio" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"
                           Text="OBS WebSocket is built into OBS 28+ for free. It lets Stream Command start and stop your stream with the Go Live button."/>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Enable in OBS (one-time, 30 seconds):" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentMuted}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="1" Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Open OBS Studio" Foreground="{DynamicResource SecondaryText}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentMuted}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="2" Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="13" VerticalAlignment="Center">
                                Click <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}">Tools</Run> in the top menu bar
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentMuted}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="3" Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="13" VerticalAlignment="Center">
                                Select <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}">WebSocket Server Settings</Run>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentMuted}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="4" Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                                Check <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}">Enable WebSocket Server</Run> and click OK
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OBS PASSWORD (optional)" Foreground="{DynamicResource LabelText}" FontSize="11" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="OBSPasswordBox" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6" FontSize="13"/>
                        <TextBlock Text="Leave blank if you didn't set one in OBS" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" Foreground="{DynamicResource LabelText}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="OBSPortBox" Style="{StaticResource ModernTextBox}" Text="4455"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TestOBSButton" Content="⚡  Test Connection" Style="{StaticResource SecondaryButton}" Padding="14,8" Click="TestOBS_Click"/>
                    <TextBlock x:Name="OBSTestResult" Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="You can skip this and connect from Live Control at any time."
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- STEP 4 — YouTube (NEW) -->
            <StackPanel x:Name="Step4" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="🔴  Connect YouTube (Optional)" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,22"
                           Text="See your YouTube channel stats alongside Twitch analytics. Manage both platforms from one dashboard."/>

                <TextBlock Text="YOUTUBE CHANNEL ID" Foreground="{DynamicResource LabelText}" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="YoutubeChannelBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,6"/>
                <Border Background="#0F1B2D" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡  " Foreground="{DynamicResource AccentLight}" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap">
                            Found in <Run Foreground="{DynamicResource AccentLight}" FontWeight="SemiBold">YouTube Studio → Settings → Channel → Advanced</Run>. Starts with "UC".
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="YOUTUBE API KEY (optional)" Foreground="{DynamicResource LabelText}" FontSize="11" Margin="0,0,0,5"/>
                <PasswordBox x:Name="YoutubeApiKeyBox" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"
                           Text="Enables live subscriber count. Get a free key from Google Cloud Console → YouTube Data API v3."/>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="✅  What you get with YouTube connected:" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="·  Subscriber count on Analytics page" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="·  Platform badge on Planner events" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="·  Quick-launch links to YouTube Studio" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="You can skip this — add YouTube credentials in Settings at any time."
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- STEP 5 — Done -->
            <StackPanel x:Name="Step5" Visibility="Collapsed" VerticalAlignment="Center">

                <!-- No-connections warning (shown when nothing was set up) -->
                <Border x:Name="NoConnectionWarning" Visibility="Collapsed"
                        Background="#2D1B00" BorderBrush="#F59E0B"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚠  No connections set up yet"
                                   Foreground="#FCD34D" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#FCD34D" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                                   Text="Stream Command works best when Twitch Chat or OBS is connected. You can set these up now from Settings → API Keys or Settings → OBS Connection."/>
                    </StackPanel>
                </Border>

                <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,18"
                        Background="#14401A" BorderBrush="#22C55E" BorderThickness="2">
                    <TextBlock Text="✓" Foreground="#86EFAC" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="You're all set!" TextAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="SetupSummary" TextAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="💡  Quick tip" Foreground="{DynamicResource AccentLight}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                   Text="When you're ready to stream, open Live Control and click Connect OBS first. The Go Live button will light up automatically once OBS is connected."/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- ══ Footer ══ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <Button x:Name="BackButton" Content="← Back" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Padding="16,8" Visibility="Collapsed" Click="Back_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="Skip for now" Style="{StaticResource SecondaryButton}"
                            Padding="14,8" Margin="0,0,10,0" Click="Skip_Click"/>
                    <Button x:Name="NextButton" Content="Let's Go  →" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
