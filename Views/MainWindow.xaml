<Window x:Class="StreamCommand.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Command"
        Icon="/Assets/icon.ico"
        Height="780" Width="1280"
        MinHeight="620" MinWidth="940"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Sidebar nav item style -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav ListBox -->
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top"
                        Padding="16,18,16,14"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#5B21B6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="▶" Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STREAM" Foreground="{DynamicResource PrimaryText}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="COMMAND" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Upgrade Pro (bottom) -->
                <Border DockPanel.Dock="Bottom"
                        Margin="10,0,10,10"
                        CornerRadius="10"
                        Padding="12,10"
                        BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonUp="UpgradePro_Click">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A0B35" Offset="0"/>
                            <GradientStop Color="#2E0F6B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="✨  Upgrade Pro" Foreground="{DynamicResource AccentLight}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Unlock all features" Foreground="{DynamicResource MutedText}"
                                   FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav Items -->
                <ListBox x:Name="NavList"
                         Style="{StaticResource NavList}"
                         SelectionChanged="NavList_SelectionChanged"
                         Padding="0,8">

                    <ListBoxItem Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" Width="20" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="live-control">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" Width="20" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Control" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="pre-stream">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑" Width="20" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Pre-Stream" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="chat-monitor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat Monitor" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="automation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Automation" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="planner">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Planner" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="analytics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Analytics" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="growth">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Growth" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="quick-launch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Quick Launch" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="tools-hub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" Width="20" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Tools Hub" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="20" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Background="{DynamicResource AppBackground}"/>
    </Grid>
</Window>
