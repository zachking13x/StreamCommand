<UserControl x:Class="StreamCommand.Views.LiveControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamCommand.Views"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1100">

            <!-- Stream Control Banner -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,14,16,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live pulse indicator -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush x:Name="LiveIndicatorBg" Color="#1A2A22"/>
                            </Border.Background>
                            <TextBlock x:Name="LiveDot" Text="◉"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Stream Control" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="StreamStatusText"
                                       Text="Connect OBS to enable Go Live"
                                       Style="{StaticResource Muted}"
                                       Margin="0,3,0,0"/>
                            <TextBlock x:Name="StreamTimerText"
                                       Text=""
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Connect OBS button -->
                        <Button x:Name="ConnectOBSButton"
                                Grid.Column="2"
                                Content="⚡  Connect OBS"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,9"
                                Click="ConnectOBS_Click"/>

                        <!-- Go Live / End Stream button -->
                        <Button x:Name="GoLiveButton"
                                Grid.Column="4"
                                Content="▶   Go Live"
                                Style="{StaticResource PrimaryButton}"
                                Padding="22,11"
                                FontSize="14"
                                IsEnabled="False"
                                Click="GoLive_Click"/>
                    </Grid>

                    <!-- OBS status strip at bottom of card -->
                    <Border x:Name="OBSStatusBar"
                            Margin="-16,0,-16,-14"
                            Padding="16,6"
                            CornerRadius="0,0,10,10"
                            Background="#0C0C0C">
                        <TextBlock x:Name="OBSStatusText"
                                   Text="OBS: Not connected — click Connect OBS or enable WebSocket in OBS Tools menu"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Message Banner -->
            <Border x:Name="LaunchMessageBorder"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentMuted}"
                    BorderBrush="{DynamicResource AccentBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <TextBlock x:Name="LaunchMessageText"
                           Foreground="{DynamicResource AccentLight}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- Scene + Audio -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scene Select -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCENE SELECT" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="ScenePanel"/>
                    </StackPanel>
                </Border>

                <!-- Audio Controls -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AUDIO CONTROLS" Style="{StaticResource Label}" Margin="0,0,0,14"/>

                        <!-- Desktop Audio -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Desktop Audio" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                            <TextBlock x:Name="DesktopAudioPct" Text="75%"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="DesktopSlider"
                                Minimum="0" Maximum="100" Value="75"
                                Margin="0,0,0,4"
                                ValueChanged="DesktopSlider_ValueChanged"/>
                        <!-- Desktop level meter -->
                        <Border x:Name="DesktopMeterTrack"
                                Height="6" CornerRadius="3"
                                Background="#2A2A42"
                                Margin="0,0,0,14">
                            <Border x:Name="DesktopMeterFill"
                                    HorizontalAlignment="Left"
                                    Height="5" Width="0" CornerRadius="3"
                                    Background="#22C55E"/>
                        </Border>

                        <!-- Microphone -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Microphone" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                            <TextBlock x:Name="MicAudioPct" Text="85%"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="MicSlider"
                                Minimum="0" Maximum="100" Value="85"
                                Margin="0,0,0,4"
                                ValueChanged="MicSlider_ValueChanged"/>
                        <!-- Mic level meter -->
                        <Border x:Name="MicMeterTrack"
                                Height="6" CornerRadius="3"
                                Background="#2A2A42"
                                Margin="0,0,0,4">
                            <Border x:Name="MicMeterFill"
                                    HorizontalAlignment="Left"
                                    Height="5" Width="0" CornerRadius="3"
                                    Background="#22C55E"/>
                        </Border>
                        <!-- Mic silence warning — appears when streaming with no signal for 5 s -->
                        <TextBlock x:Name="MicSilenceWarning"
                                   Text="⚠  No mic signal detected — check your input in OBS"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MicButton"
                                    Grid.Column="0"
                                    Content="🎙  Mic On"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="MicButton_Click"/>
                            <Button x:Name="CamButton"
                                    Grid.Column="2"
                                    Content="📷  Cam On"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CamButton_Click">
                                <!-- BUG 6: this is a visual reminder only — cam must be toggled in OBS -->
                                <Button.ToolTip>
                                    <ToolTip Content="Reminder only — camera source must be toggled in OBS"/>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Live Preview ─────────────────────────────────────────────────
                 Visible only while OBS is connected; hidden when disconnected. -->
            <Border x:Name="PreviewPanel"
                    Style="{StaticResource Card}"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Button x:Name="PreviewBtn"
                                Content="👁  Start Preview"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6"
                                Click="StartPreview_Click"/>
                    </Grid>

                    <!-- Pro-gated area -->
                    <Grid>
                        <!-- Preview content — Pro users only -->
                        <StackPanel x:Name="PreviewContent" Visibility="Collapsed">
                            <!-- 16:9 preview with overlaid badges -->
                            <Grid Background="#0A0A0F" Height="360">
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"/>
                                <!-- LIVE badge — top-right, visible while streaming -->
                                <Border x:Name="LiveBadge"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#CC000000" CornerRadius="4"
                                        Padding="8,4" Margin="8"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#EF4444"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="LIVE" Foreground="White"
                                                   FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Error shown when OBS Virtual Camera is not found -->
                            <TextBlock x:Name="PreviewError"
                                       Text="OBS Virtual Camera not found — in OBS click Start Virtual Camera first."
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Upgrade prompt — free users -->
                        <local:ProGateBanner x:Name="PreviewProGate"
                                             FeatureLabel="Live stream preview"
                                             Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Open Stream App -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="OPEN STREAM APP" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Button Tag="obs"           Content="🎬  OBS Studio"       Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="0,14" Click="LaunchApp_Click">
                            <Button.ToolTip>Open Broadcaster Software — installed on your PC</Button.ToolTip>
                        </Button>
                        <Button Tag="streamlabs"    Content="🎮  Streamlabs"        Style="{StaticResource SecondaryButton}" Margin="6,0,0,6" Padding="0,14" Click="LaunchApp_Click"/>
                        <Button Tag="twitch-studio" Content="🟣  Twitch Studio"     Style="{StaticResource SecondaryButton}" Margin="0,6,6,0" Padding="0,14" Click="LaunchApp_Click"/>
                        <Button Tag="xsplit"        Content="✖  XSplit Broadcaster" Style="{StaticResource SecondaryButton}" Margin="6,6,0,0" Padding="0,14" Click="LaunchApp_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Offline / Setup Guide Banner -->
            <Border x:Name="OfflineBanner"
                    Background="{DynamicResource AccentMuted}"
                    BorderBrush="{DynamicResource AccentBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Connect OBS to enable stream control"
                                   Foreground="{DynamicResource AccentLight}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <!-- Steps -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                    Width="18" Height="18" Margin="0,0,8,0">
                                <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="In OBS: Tools → WebSocket Server Settings → tick Enable"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                    Width="18" Height="18" Margin="0,0,8,0">
                                <TextBlock Text="2" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Set your port + password in Settings → OBS Connection"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                    Width="18" Height="18" Margin="0,0,8,0">
                                <TextBlock Text="3" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Click ⚡ Connect OBS above — scenes load automatically"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Open OBS Settings →"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Padding="14,8"
                            Click="GoToOBSSettings_Click"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
