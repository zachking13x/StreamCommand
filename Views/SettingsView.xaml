<UserControl x:Class="StreamCommand.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="800">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" FontSize="18"/>
                    <TextBlock Text="Configure your accounts and app preferences"
                               Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="SaveBtn"
                        Content="💾  Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="16,9"
                        Click="Save_Click"/>
            </Grid>

            <!-- Saved banner -->
            <Border x:Name="SavedBanner"
                    Visibility="Collapsed"
                    Background="#14401A"
                    BorderBrush="#22C55E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <TextBlock Text="✓  Settings saved successfully."
                           Foreground="#86EFAC"
                           FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <!-- Channel Info -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Channel Info" Style="{StaticResource SectionHeader}" Margin="0,0,0,14"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Twitch Username" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TwitchUsername" Style="{StaticResource ModernTextBox}" Tag="your_twitch_username"/>
                        <TextBlock Text="Your Twitch channel name" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="YouTube Channel ID" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="YoutubeChannelId" Style="{StaticResource ModernTextBox}" Tag="UCxxxxxxxxxxxxxxxxxxxxxxx"/>
                        <TextBlock Text="Found in YouTube Studio → Settings → Channel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Discord Server Invite" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DiscordInvite" Style="{StaticResource ModernTextBox}" Tag="https://discord.gg/..."/>
                        <TextBlock Text="Public invite link for your community server" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- API Keys -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="API Keys" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Stored locally on your device only — never sent to any server."
                                   Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Twitch Client ID" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TwitchClientId" Style="{StaticResource ModernTextBox}" Tag="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="From your " Style="{StaticResource Muted}"/>
                            <TextBlock Text="Twitch Developer Console ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="OpenTwitchDev_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Password-field note -->
                    <Border Background="#0F1B2D" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                   Text="🔒  Password fields are always blank when Settings opens — this is intentional. Leave any field blank to keep the currently saved value. Only type in a field if you want to change it."/>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Twitch Client Secret" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TwitchClientSecret"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="13"/>
                        <TextBlock x:Name="TwitchClientSecretSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="Keep this secret — never share it publicly" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="YouTube API Key" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="YoutubeApiKey"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="13"/>
                        <TextBlock x:Name="YoutubeApiKeySaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="From " Style="{StaticResource Muted}"/>
                            <TextBlock Text="Google Cloud Console ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="OpenGoogleCloud_Click"/>
                            <TextBlock Text=" with YouTube Data API v3 enabled" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="StreamElements JWT Token" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="SeToken"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="13"/>
                        <TextBlock x:Name="SeTokenSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="From " Style="{StaticResource Muted}"/>
                            <TextBlock Text="StreamElements → Account → API Access ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="OpenSE_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OBS WebSocket -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="OBS WebSocket" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="In OBS: Tools → WebSocket Server Settings → Enable. Free &amp; built into OBS 28+."/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WebSocket Password" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="OBSPassword"
                                         Background="{DynamicResource InputBackground}"
                                         Foreground="{DynamicResource PrimaryText}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1" Padding="10,6" FontSize="13"/>
                            <TextBlock x:Name="OBSPasswordSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="Leave blank if you didn't set a password in OBS" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="OBSPort" Style="{StaticResource ModernTextBox}" Text="4455"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Twitch Chat -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Twitch Chat Token" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="Lets Chat Monitor read your live chat. No app registration needed."/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Twitch Chat OAuth Token" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TwitchChatToken"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="10,6" FontSize="13"/>
                        <TextBlock x:Name="TwitchChatTokenSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Get your free token at " Style="{StaticResource Muted}"/>
                            <TextBlock Text="twitchapps.com/tmi ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12" Cursor="Hand"
                                       MouseLeftButtonDown="OpenTMI_Click"/>
                            <TextBlock Text=" (sign in with Twitch)" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0,0,0,14"/>
                    <TextBlock Text="ACCENT COLOR" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand" BorderBrush="White" BorderThickness="2">
                            <Border.Background><SolidColorBrush Color="#7C3AED"/></Border.Background>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand">
                            <Border.Background><SolidColorBrush Color="#2563EB"/></Border.Background>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand">
                            <Border.Background><SolidColorBrush Color="#DB2777"/></Border.Background>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand">
                            <Border.Background><SolidColorBrush Color="#16A34A"/></Border.Background>
                        </Border>
                        <Border Width="28" Height="28" CornerRadius="14" Cursor="Hand">
                            <Border.Background><SolidColorBrush Color="#EA580C"/></Border.Background>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <TextBlock Text="Stream Command  v1.0.0" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                    <TextBlock Text="All-in-one streaming companion — built for streamers, by a streamer."
                               Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
