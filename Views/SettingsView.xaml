<UserControl x:Class="StreamCommand.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="800">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" FontSize="18"/>
                    <TextBlock Text="Configure your accounts and app preferences"
                               Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="SaveBtn"
                        Content="💾  Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="16,9"
                        Click="Save_Click"/>
            </Grid>

            <!-- Saved banner -->
            <Border x:Name="SavedBanner"
                    Visibility="Collapsed"
                    Background="#14401A"
                    BorderBrush="#22C55E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <TextBlock Text="✓  Settings saved successfully."
                           Foreground="#86EFAC"
                           FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <!-- Channel Info -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Channel Info" Style="{StaticResource SectionHeader}" Margin="0,0,0,14"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Twitch Username" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TwitchUsername" Style="{StaticResource ModernTextBox}" Tag="your_twitch_username"/>
                        <TextBlock Text="Your Twitch channel name" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="YouTube Channel ID" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="YoutubeChannelId" Style="{StaticResource ModernTextBox}" Tag="UCxxxxxxxxxxxxxxxxxxxxxxx"/>
                        <TextBlock Text="Found in YouTube Studio → Settings → Channel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Discord Server Invite" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DiscordInvite" Style="{StaticResource ModernTextBox}" Tag="https://discord.gg/..."/>
                        <TextBlock Text="Public invite link for your community server" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- API Keys -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="API Keys" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                    <!-- Privacy banner — prominent -->
                    <Border Background="#0D1E1A" BorderBrush="#22C55E"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Your keys stay on your device — always."
                                           Foreground="#86EFAC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                           Text="API keys are saved only in a local JSON file on this PC. Stream Command never transmits them to any server, cloud, or third party."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Password-field note -->
                    <Border Background="#0F1B2D" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                   Text="🔒  Password fields are always blank when Settings opens — this is intentional. Leave any field blank to keep the currently saved value. Only type in a field if you want to change it."/>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="YouTube API Key" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="YoutubeApiKey"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="13"/>
                        <TextBlock x:Name="YoutubeApiKeySaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="From " Style="{StaticResource Muted}"/>
                            <TextBlock Text="Google Cloud Console ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="OpenGoogleCloud_Click"/>
                            <TextBlock Text=" with YouTube Data API v3 enabled" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="StreamElements JWT Token" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="SeToken"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="13"/>
                        <TextBlock x:Name="SeTokenSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="From " Style="{StaticResource Muted}"/>
                            <TextBlock Text="StreamElements → Account → API Access ↗"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="OpenSE_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OBS WebSocket -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="OBS WebSocket" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="In OBS: Tools → WebSocket Server Settings → Enable. Free &amp; built into OBS 28+."/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WebSocket Password" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="OBSPassword"
                                         Background="{DynamicResource InputBackground}"
                                         Foreground="{DynamicResource PrimaryText}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1" Padding="10,6" FontSize="13"/>
                            <TextBlock x:Name="OBSPasswordSaved" Text="✓  Already saved — leave blank to keep" Foreground="#22C55E" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="Leave blank if you didn't set a password in OBS" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="OBSPort" Style="{StaticResource ModernTextBox}" Text="4455"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Twitch Connection (OAuth) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Twitch Connection" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="Sign in with Twitch to enable chat, follower alerts, subscriber events, and channel stats."/>
                    </StackPanel>

                    <!-- Currently connected account -->
                    <Border x:Name="TwitchConnectedBanner"
                            Visibility="Collapsed"
                            Background="#0D2A1A" BorderBrush="#22C55E"
                            BorderThickness="1" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="#22C55E" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TwitchConnectedText"
                                       Foreground="#86EFAC" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ConnectTwitchBtn"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Padding="16,9"
                            Click="ConnectTwitch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟣" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Connect with Twitch" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Device code panel — shown while waiting for user to approve in browser -->
                    <Border x:Name="DeviceCodePanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource AccentMuted}"
                            BorderBrush="{DynamicResource AccentBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="A browser window just opened — enter this code at twitch.tv/activate:"
                                       Foreground="{DynamicResource AccentLight}"
                                       FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <!-- The user code — big, easy to read -->
                            <Border Background="{DynamicResource CardBackground}"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="DeviceCodeLabel"
                                           FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⏳  Waiting for you to approve…"
                                           Foreground="{DynamicResource MutedText}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CancelTwitchBtn"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6" FontSize="12"
                                    Click="CancelTwitch_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Error detail — shown when auth fails -->
                    <Border x:Name="TwitchErrorBanner"
                            Visibility="Collapsed"
                            Background="#2D0A0A"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TwitchErrorStep"
                                       Foreground="#FCA5A5"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="TwitchErrorDetail"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Your access token is saved only on this PC and never transmitted to any server."/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0,0,0,14"/>
                    <TextBlock Text="ACCENT COLOR" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal">
                        <Border x:Name="Swatch1" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand"
                                Tag="#6B9E85" MouseLeftButtonUp="ColorSwatch_Click">
                            <Border.Background><SolidColorBrush Color="#6B9E85"/></Border.Background>
                        </Border>
                        <Border x:Name="Swatch2" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand"
                                Tag="#2563EB" MouseLeftButtonUp="ColorSwatch_Click">
                            <Border.Background><SolidColorBrush Color="#2563EB"/></Border.Background>
                        </Border>
                        <Border x:Name="Swatch3" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand"
                                Tag="#DB2777" MouseLeftButtonUp="ColorSwatch_Click">
                            <Border.Background><SolidColorBrush Color="#DB2777"/></Border.Background>
                        </Border>
                        <Border x:Name="Swatch4" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" Cursor="Hand"
                                Tag="#16A34A" MouseLeftButtonUp="ColorSwatch_Click">
                            <Border.Background><SolidColorBrush Color="#16A34A"/></Border.Background>
                        </Border>
                        <Border x:Name="Swatch5" Width="28" Height="28" CornerRadius="14" Cursor="Hand"
                                Tag="#EA580C" MouseLeftButtonUp="ColorSwatch_Click">
                            <Border.Background><SolidColorBrush Color="#EA580C"/></Border.Background>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Privacy Statement -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Privacy — Plain English" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Stream Command does not collect, transmit, or sell your data. Here's exactly what we do and don't do:"/>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="✅  API keys and tokens → saved only on this PC, in a local file" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="✅  Stream analytics → loaded directly from Twitch's API to your screen" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="✅  Chat messages → streamed from Twitch IRC directly to this app" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="✅  Your subscription status → checked via the Microsoft Store only" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="❌  We do NOT have a backend server receiving your data" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,2"/>
                        <TextBlock Text="❌  We do NOT share anything with third parties" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <TextBlock Text="Stream Command  v1.0.11" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                    <TextBlock Text="All-in-one streaming companion — built for streamers, by a streamer."
                               Style="{StaticResource Muted}" Margin="0,3,0,14"/>

                    <!-- Pro status indicator -->
                    <Border x:Name="ProStatusBanner" CornerRadius="6" Padding="10,7" Margin="0,0,0,12"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="ProStatusText" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Unlock code entry — for developer / beta testers -->
                    <StackPanel x:Name="UnlockPanel">
                        <TextBlock Text="UNLOCK CODE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UnlockCodeBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     Tag="Enter code…"
                                     MaxLength="40"/>
                            <Button Grid.Column="2"
                                    Content="Activate"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,7" FontSize="12"
                                    Click="ActivateCode_Click"/>
                        </Grid>
                        <TextBlock x:Name="UnlockResultText"
                                   FontSize="11" Margin="0,5,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
