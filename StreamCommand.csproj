<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StreamCommand</AssemblyName>
    <RootNamespace>StreamCommand</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- Version â€” bump these for every Store submission -->
    <Version>1.0.28</Version>
    <AssemblyVersion>1.0.28.0</AssemblyVersion>
    <FileVersion>1.0.28.0</FileVersion>
    <Company>Zach Kramer</Company>
    <Authors>Zach Kramer</Authors>
    <Product>Stream Command</Product>
    <Copyright>Copyright Â© 2026 Zach Kramer</Copyright>
    <Description>Control your whole stream without leaving your game â€” switch scenes, manage audio, and go live without alt-tabbing out.</Description>
    <!-- Produce a self-contained single-folder publish for packaging -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>

  <!-- The test project lives inside this folder; keep its sources out of the app build. -->
  <ItemGroup>
    <Compile Remove="StreamCommand.Tests\**" />
    <None Remove="StreamCommand.Tests\**" />
    <Page Remove="StreamCommand.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" Condition="Exists('Assets\icon.ico')" />
    <Resource Include="Themes\DarkTheme.xaml" />
  </ItemGroup>

</Project>
